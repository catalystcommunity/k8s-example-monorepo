"""
This module defines the dependencies and configurations for the k8s-example-monorepo project.
It includes rules for OCI, Python, Rust, Go, and other tools required for the build process.
"""

module(
    name = "k8s-example-monorepo",
    version = "0.0.0",
    compatibility_level = 1,
)

# Dependencies
bazel_dep(name = "rules_oci", version = "1.7.4")

# Including rules_pkg for pkg_tar which is needed to create tarballs for OCI images
bazel_dep(name = "rules_pkg", version = "1.0.1")

# For rust things we don't have yet
bazel_dep(name = "rules_rust", version = "0.59.2")

# OCI setup for containers
oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")

bazel_dep(name = "rules_python", version = "1.3.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.13",
)

# A bazel_dep declaration is needed for each direct dependency
# of this module. We need rules_go since it's not built into Bazel.
bazel_dep(name = "rules_go", version = "0.52.0")

# We use rules_go's go_sdk module extension to download and configure
# the Go toolchain and standard library. To ensure a deterministic build,
# Bazel typically uses the Go toolchain downloaded here instead of
# one installed on the host machine.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.23.4")

bazel_dep(name = "gazelle", version = "0.42.0", repo_name = "bazel_gazelle")

go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//app_api:go.mod")

# All *direct* Go dependencies of the module have to be listed explicitly.
use_repo(
    go_deps,
    "com_github_brianvoe_gofakeit_v6",
    "com_github_catalystcommunity_app_utils_go",
    "com_github_catalystcommunity_k8s_example_monorepo_coredb",
    "com_github_gammazero_workerpool",
    "com_github_google_uuid",
    "com_github_jackc_pgx_v4",
    "com_github_lib_pq",
    "com_github_pressly_goose_v3",
    "com_github_rs_cors",
    "com_github_sirupsen_logrus",
    "com_github_stretchr_testify",
    "com_github_urfave_cli_v2",
    "io_gorm_driver_postgres",
    "io_gorm_gorm",
    "org_golang_x_crypto",
)

bazel_dep(name = "rules_python_gazelle_plugin", version = "1.3.0")

# Use the pip extension
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")

# Use the extension to call the `pip_repository` rule that invokes `pip`, with `incremental` set.
# Accepts a locked/compiled requirements file and installs the dependencies listed within.
# Those dependencies become available in a generated `requirements.bzl` file.
# You can instead check this `requirements.bzl` file into your repo.
# Because this project has different requirements for windows vs other
# operating systems, we have requirements for each.
pip.parse(
    hub_name = "pip",
    python_version = "3.13",
    requirements_lock = "//:requirements_lock.txt",
)

# Imports the pip toolchain generated by the given module extension into the scope of the current module.
use_repo(pip, "pip")
